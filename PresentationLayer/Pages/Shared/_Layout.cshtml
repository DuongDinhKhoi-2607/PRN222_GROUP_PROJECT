@inject BussinessLayer.Interfaces.IUserService UserService
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="RAG AI Assistant – Chat and Document Management" />
    <title>@ViewData["Title"] - RAG AI Assistant</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @{
        var path = Context.Request.Path.Value ?? "";
        var isChat   = path.Contains("/Chat",   StringComparison.OrdinalIgnoreCase);
        var isUpload = path.Contains("/Upload",  StringComparison.OrdinalIgnoreCase);

        // Get authenticated user claims
        var userName = User.Identity?.IsAuthenticated == true ? User.Identity.Name : "Khách";
        var roleClaim = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
        var isLecturerOrAdmin = roleClaim == "lecturer" || roleClaim == "admin";

        var roleDisplay = roleClaim switch {
            "admin" => "Quản trị viên",
            "lecturer" => "Giảng viên",
            "student" => "Sinh viên",
            _ => "Khách"
        };

        var isTempPassword = false;
        int availableTokens = 0;
        bool isPro = false;

        if (User.Identity?.IsAuthenticated == true)
        {
            var userIdClaim = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
            if (userIdClaim != null && long.TryParse(userIdClaim.Value, out var userId))
            {
                if (roleClaim == "lecturer") 
                {
                    isTempPassword = await UserService.IsUsingTempPasswordAsync(userId);
                } 
                else if (roleClaim == "student") 
                {
                    var tokenInfo = await UserService.GetUserTokenInfoAsync(userId);
                    availableTokens = tokenInfo.AvailableTokens;
                    isPro = tokenInfo.IsPro;
                }
            }
        }
    }

    <div class="app-shell">
        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <div class="brand-icon">
                    <i class="fa-solid fa-brain"></i>
                </div>
                <span class="brand-name">RAG Assistant</span>
            </div>

            <nav class="sidebar-nav">
                @if (!isTempPassword)
                {
                    <div class="nav-section-label">Main</div>
                    @if (roleClaim == "student" || roleClaim == "lecturer")
                    {
                        <a href="/Chat" class="nav-item @(isChat ? "active" : "")">
                            <i class="fa-solid fa-comments"></i>
                            <span>Chat AI</span>
                            <div class="nav-indicator"></div>
                        </a>
                    }

                    @if (roleClaim == "lecturer")
                    {
                        <a href="/Document" class="nav-item @(path.Contains("/Document", StringComparison.OrdinalIgnoreCase) && !isUpload ? "active" : "")">
                            <i class="fa-solid fa-folder-open"></i>
                            <span>Quản lý Tài liệu</span>
                            <div class="nav-indicator"></div>
                        </a>
                    }
                    @if (isLecturerOrAdmin)
                    {
                        <a href="/Subject" class="nav-item @(path.Contains("/Subject", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <i class="fa-solid fa-book"></i>
                            <span>Quản lý Môn học</span>
                            <div class="nav-indicator"></div>
                        </a>
                    }
                    @if (roleClaim == "admin")
                    {
                        <div class="nav-section-label" style="margin-top:.75rem">Admin</div>
                        <a href="/Admin" class="nav-item @(path.Contains("/Admin", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <i class="fa-solid fa-user-shield"></i>
                            <span>Quản lý Quyền</span>
                            <div class="nav-indicator"></div>
                        </a>
                    }
                    @if (roleClaim == "benchmarkmanager" || roleClaim == "admin")
                    {
                        <div class="nav-section-label" style="margin-top:.75rem">Đánh giá AI</div>
                        <a href="/Benchmark" class="nav-item @(path.Contains("/Benchmark", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <i class="fa-solid fa-chart-line"></i>
                            <span>Benchmark Studio</span>
                            <div class="nav-indicator"></div>
                        </a>
                    }

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="nav-section-label" style="margin-top:.75rem">Tài khoản</div>
                        <a href="/Auth/ChangePassword" class="nav-item @(path.Contains("/Auth/ChangePassword", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <i class="fa-solid fa-key"></i>
                            <span>Đổi mật khẩu</span>
                            <div class="nav-indicator"></div>
                        </a>
                    }
                }
                else
                {
                    <div class="nav-section-label">Yêu cầu đổi mật khẩu</div>
                    <a href="/Auth/ChangePassword" class="nav-item active">
                        <i class="fa-solid fa-key"></i>
                        <span>Đổi mật khẩu</span>
                        <div class="nav-indicator"></div>
                    </a>
                }
            </nav>

            <div class="sidebar-footer">
                <div class="user-badge">
                    <div class="user-avatar" style="background: @(roleClaim == "lecturer" || roleClaim == "admin" ? "linear-gradient(135deg,#6c63ff,#a78bfa)" : "linear-gradient(135deg,#00d4aa,#00b090)")">
                        <i class="fa-solid @(roleClaim == "lecturer" || roleClaim == "admin" ? "fa-chalkboard-user" : "fa-graduation-cap")"></i>
                    </div>
                    <div class="user-info" style="flex: 1; min-width: 0; margin-left: 0.5rem;">
                        <span class="user-name" title="@userName" style="display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@userName</span>
                        <span class="user-role" style="display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@roleDisplay</span>
                    </div>
                    <a href="/Auth/Logout" class="btn-logout" title="Đăng xuất" style="color: var(--accent-danger); font-size: 1.05rem; padding: .3rem; transition: transform var(--transition); display: flex; align-items: center; justify-content: center; text-decoration: none;">
                        <i class="fa-solid fa-power-off"></i>
                    </a>
                </div>
            </div>
        </aside>

        <!-- Main Content -->
        <div class="main-area">
            <header class="topbar">
                <button class="sidebar-toggle" id="sidebarToggle" onclick="toggleSidebar()">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <div class="topbar-title">@(ViewData["Title"] ?? "RAG Assistant")</div>
                <div class="topbar-actions">
                    @if (roleClaim == "student")
                    {
                        <a href="/Upgrade" class="status-badge @(isPro ? "online" : "")" style="text-decoration: none; margin-right: 1rem; @(isPro ? "" : "background: rgba(255,159,67,0.15); border: 1px solid rgba(255,159,67,0.3);")">
                            @if (isPro)
                            {
                                <i class="fa-solid fa-crown" style="color: gold;"></i>
                                <span style="font-weight: bold; margin-left: 5px;">PRO</span>
                            }
                            else
                            {
                                <i class="fa-solid fa-bolt" style="color: #ff9f43;"></i>
                                <span style="font-weight: bold; margin-left: 5px; color: #ff9f43;">@availableTokens Tokens | Nâng cấp gói Pro</span>
                            }
                        </a>
                    }
                    <div class="status-badge online">
                        <span class="status-dot"></span>
                        <span>System Online</span>
                    </div>
                </div>
            </header>

            <main class="page-content" role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <script>
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('collapsed');
        }
    </script>

    @if (User.Identity?.IsAuthenticated == true && isLecturerOrAdmin)
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
        <script>
            if (typeof window.hubConnection === 'undefined') {
                window.hubConnection = new signalR.HubConnectionBuilder()
                    .withUrl("/documentHub")
                    .withAutomaticReconnect()
                    .build();

                window.hubConnection.start().then(function () {
                    console.log("Global SignalR: Connected to DocumentHub!");
                }).catch(function (err) {
                    console.error("Global SignalR Connection Error: ", err.toString());
                });
            }

            window.hubConnection.on("ReceiveSystemUpdate", function (type, message) {
                console.log("System update received via SignalR: ", type, message);
                showSystemToast(message);
                
                const path = window.location.pathname.toLowerCase();
                // Check if current page is document list, subject list, or admin page
                if (path.includes("/document") || path.includes("/subject") || path.includes("/admin")) {
                    setTimeout(() => {
                        window.location.reload();
                    }, 2000);
                }
            });

            function showSystemToast(message) {
                let container = document.getElementById("system-toast-container");
                if (!container) {
                    container = document.createElement("div");
                    container.id = "system-toast-container";
                    container.style.cssText = "position: fixed; top: 20px; right: 20px; z-index: 9999; display: flex; flex-direction: column; gap: 10px;";
                    document.body.appendChild(container);
                }

                const toast = document.createElement("div");
                toast.style.cssText = "background: rgba(30, 30, 45, 0.85); border-left: 4px solid #6c63ff; color: #fff; padding: 12px 20px; border-radius: 8px; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.37); font-family: 'Inter', sans-serif; font-size: 0.85rem; display: flex; align-items: center; gap: 12px; min-width: 280px; backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.08); border-left: 4px solid #6c63ff; animation: toast-in 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55) forwards;";
                toast.innerHTML = `<i class="fa-solid fa-bell" style="color: #a78bfa; font-size: 1rem;"></i> <div style="flex: 1; line-height: 1.4;">${message}</div>`;
                
                if (!document.getElementById("toast-animation-style")) {
                    const style = document.createElement("style");
                    style.id = "toast-animation-style";
                    style.innerHTML = `
                        @@keyframes toast-in {
                            from { transform: translateX(120%) scale(0.9); opacity: 0; }
                            to { transform: translateX(0) scale(1); opacity: 1; }
                        }
                        @@keyframes toast-out {
                            from { transform: translateX(0) scale(1); opacity: 1; }
                            to { transform: translateX(120%) scale(0.9); opacity: 0; }
                        }
                    `;
                    document.head.appendChild(style);
                }

                container.appendChild(toast);

                setTimeout(() => {
                    toast.style.animation = "toast-out 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55) forwards";
                    setTimeout(() => {
                        toast.remove();
                    }, 300);
                }, 4000);
            }
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
