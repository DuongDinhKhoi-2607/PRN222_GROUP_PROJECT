@page
@model PresentationLayer.Pages.Chat.IndexModel
@{
    ViewData["Title"] = "Phiên Chat AI";
}

<style>
    :root {
        --chat-bg: #0b0d14;
        --chat-surface: rgba(20, 24, 34, 0.65);
        --chat-border: rgba(255, 255, 255, 0.08);
        --primary-gradient: linear-gradient(135deg, #6c63ff, #a78bfa);
        --msg-bot-bg: rgba(255, 255, 255, 0.04);
        --msg-user-bg: var(--primary-gradient);
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
        width: 6px;
    }

    ::-webkit-scrollbar-track {
        background: transparent;
    }

    ::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.1);
        border-radius: 10px;
    }

        ::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.2);
        }

    .chat-layout {
        display: flex;
        height: calc(100vh - 60px); 
        margin: 0; 
        background: var(--chat-bg);
        font-family: 'Inter', sans-serif;
        border-radius: 16px; 
        border: 1px solid var(--chat-border);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3); 
        overflow: hidden;
    }

    /* Sidebar */
    .chat-sidebar {
        width: 280px;
        background: var(--chat-surface);
        backdrop-filter: blur(10px);
        border-right: 1px solid var(--chat-border);
        display: flex;
        flex-direction: column;
        z-index: 10;
    }

    /* Đã thêm: Đồng bộ chiều cao thanh header Sidebar (70px) và kéo viền ngang */
    .sidebar-header {
        height: 70px;
        padding: 0 1rem;
        display: flex;
        align-items: center;
        border-bottom: 1px solid var(--chat-border);
    }

    .btn-new-chat {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        width: 100%;
        padding: 0.8rem 1rem;
        background: var(--primary-gradient);
        border-radius: 12px;
        color: #fff;
        font-size: 0.95rem;
        font-weight: 600;
        text-decoration: none;
        box-shadow: 0 4px 15px rgba(108, 99, 255, 0.3);
        transition: all 0.3s ease;
    }

        .btn-new-chat:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(108, 99, 255, 0.4);
            color: #fff;
        }

    .history-item {
        display: flex;
        align-items: center;
        padding: 0.75rem 1rem;
        color: #cbd5e1;
        text-decoration: none;
        border-radius: 10px;
        margin-bottom: 0.4rem;
        font-size: 0.9rem;
        transition: all 0.2s ease;
        border: 1px solid transparent;
    }

        .history-item:hover {
            background: rgba(255, 255, 255, 0.05);
            color: #fff;
        }

        .history-item i {
            margin-right: 0.75rem;
            font-size: 1rem;
        }

    .history-text {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        flex: 1;
    }

    /* Main Area */
    .chat-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        position: relative;
    }

    /* Đã sửa: Khóa chiều cao 70px y hệt Sidebar để 2 bên thẳng hàng tắp lự */
    .chat-header {
        height: 70px;
        padding: 0 1.5rem;
        border-bottom: 1px solid var(--chat-border);
        background: rgba(11, 13, 20, 0.8);
        backdrop-filter: blur(10px);
        display: flex;
        align-items: center;
        justify-content: space-between;
        z-index: 10;
    }

    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .chat-empty {
        margin: auto;
        text-align: center;
        max-width: 400px;
        color: #94a3b8;
    }

    .chat-empty-icon {
        width: 70px;
        height: 70px;
        background: var(--primary-gradient);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        color: white;
        margin: 0 auto 1.5rem;
        box-shadow: 0 10px 25px rgba(108, 99, 255, 0.3);
    }

    .chat-empty h3 {
        color: #fff;
        font-size: 1.25rem;
        margin-bottom: 0.75rem;
    }

    /* Message Bubbles */
    .msg-row {
        display: flex;
        gap: 1rem;
        max-width: 85%;
        animation: fadeIn 0.3s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .msg-row.user {
        align-self: flex-end;
        flex-direction: row-reverse;
    }

    .msg-row.bot {
        align-self: flex-start;
    }

    .msg-avatar {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 1rem;
    }

    .msg-row.user .msg-avatar {
        background: rgba(255, 255, 255, 0.1);
        color: #fff;
    }

    .msg-row.bot .msg-avatar {
        background: var(--primary-gradient);
        color: #fff;
        box-shadow: 0 4px 10px rgba(108, 99, 255, 0.2);
    }

    .msg-body {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .msg-row.user .msg-body {
        align-items: flex-end;
    }

    .msg-bubble {
        padding: 0.85rem 1.2rem;
        font-size: 0.95rem;
        line-height: 1.6;
        color: #fff;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .msg-row.user .msg-bubble {
        background: var(--msg-user-bg);
        border-radius: 18px 18px 4px 18px;
    }

    .msg-row.bot .msg-bubble {
        background: var(--msg-bot-bg);
        border: 1px solid var(--chat-border);
        border-radius: 18px 18px 18px 4px;
        backdrop-filter: blur(10px);
    }

    .msg-time {
        font-size: 0.75rem;
        color: #64748b;
    }

    /* Typing Indicator */
    .typing-dots {
        display: flex;
        gap: 4px;
        padding: 0.5rem;
    }

        .typing-dots span {
            width: 6px;
            height: 6px;
            background: #a78bfa;
            border-radius: 50%;
            animation: typing 1.4s infinite ease-in-out both;
        }

            .typing-dots span:nth-child(1) {
                animation-delay: -0.32s;
            }

            .typing-dots span:nth-child(2) {
                animation-delay: -0.16s;
            }

    @@keyframes typing {
        0%, 80%, 100% {
            transform: scale(0);
        }

        40% {
            transform: scale(1);
        }
    }

    /* Input Area */
    .chat-input-bar {
        padding: 1.5rem 2rem;
        background: linear-gradient(to top, var(--chat-bg) 50%, transparent);
    }

    .input-row {
        background: rgba(30, 35, 48, 0.7);
        backdrop-filter: blur(12px);
        border: 1px solid var(--chat-border);
        border-radius: 16px;
        display: flex;
        align-items: flex-end;
        padding: 0.5rem;
        transition: all 0.3s ease;
    }

        .input-row:focus-within {
            border-color: #6c63ff;
            box-shadow: 0 0 0 3px rgba(108, 99, 255, 0.15);
        }

        .input-row textarea {
            flex: 1;
            background: transparent;
            border: none;
            color: #fff;
            padding: 0.6rem 1rem;
            font-size: 0.95rem;
            resize: none;
            max-height: 150px;
            outline: none;
        }

            .input-row textarea::placeholder {
                color: #64748b;
            }

    .btn-send {
        background: var(--primary-gradient);
        color: white;
        border: none;
        width: 40px;
        height: 40px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
        margin: 0.2rem;
    }

        .btn-send:hover:not(:disabled) {
            transform: scale(1.05);
            box-shadow: 0 4px 12px rgba(108, 99, 255, 0.4);
        }

        .btn-send:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
</style>

<div class="chat-layout">
    <div class="chat-sidebar">
        <!-- Đã bọc nút tạo mới vào class sidebar-header -->
        <div class="sidebar-header">
            <a asp-page="Index" class="btn-new-chat">
                <i class="fa-solid fa-plus"></i> Tạo phiên mới
            </a>
        </div>
        
        <div style="padding: 1.25rem 1rem 1rem; flex: 1; overflow-y: auto;">
            <div style="font-size: 0.75rem; font-weight: 600; color: #64748b; margin-bottom: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px; padding-left: 0.5rem;">
                Gần đây
            </div>
            @if (Model.History != null)
            {
                foreach (var h in Model.History)
                {
                    <a asp-page="Session" asp-route-id="@h.Id" class="history-item" title="@(string.IsNullOrWhiteSpace(h.Title) ? $"Phiên #{h.Id}" : h.Title)">
                        <i class="fa-regular fa-message" style="color: #64748b;"></i>
                        <span class="history-text">@(string.IsNullOrWhiteSpace(h.Title) ? $"Phiên #{h.Id}" : h.Title)</span>
                    </a>
                }
            }
        </div>
    </div>

    <div class="chat-main">
        <div class="chat-header">
            <h3 style="font-size: 1.05rem; font-weight: 600; color: #fff; margin: 0; display: flex; align-items: center; gap: 0.6rem;">
                <i class="fa-solid fa-layer-group" style="color: #a78bfa;"></i>
                Phiên Chat Mới
            </h3>
            <a asp-page="Index" style="color: #64748b; font-size: 1.2rem; transition: color 0.2s;" title="Đóng phiên">
                <i class="fa-solid fa-xmark"></i>
            </a>
        </div>

        <div class="chat-messages" id="chatMessages">
            <div class="chat-empty">
                <div class="chat-empty-icon"><i class="fa-solid fa-robot"></i></div>
                <h3>Xin chào! RAG Assistant đã sẵn sàng.</h3>
                <p style="line-height: 1.6; font-size: 0.95rem;">Tôi có thể giúp bạn tìm kiếm thông tin và giải đáp thắc mắc dựa trên tất cả tài liệu môn học hiện có. Hãy gửi câu hỏi đầu tiên bên dưới.</p>
            </div>
        </div>

        <div class="chat-input-bar">
            <form asp-page-handler="Send" method="post" id="chatForm">
                <input type="hidden" name="sessionId" value="0" />
                <div class="input-row">
                    <textarea id="question" name="question" placeholder="Nhập câu hỏi của bạn (Shift + Enter để xuống dòng)..." rows="1" required></textarea>

                    <button type="submit" class="btn-send" id="btnSend">
                        <i class="fa-solid fa-paper-plane"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const msgContainer = document.getElementById('chatMessages');
        const qInput = document.getElementById('question');
        const form = document.getElementById('chatForm');
        const btnSend = document.getElementById('btnSend');

        function scrollToBottom() {
            if (msgContainer) {
                msgContainer.scrollTop = msgContainer.scrollHeight;
            }
        }

        qInput.addEventListener('input', function() {
            this.style.height = 'auto';
            this.style.height = (this.scrollHeight) + 'px';
            if (this.value.trim() === '') {
                this.style.height = 'auto';
            }
        });

        qInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                if (this.value.trim() !== '') {
                    btnSend.click(); 
                }
            }
        });

        form.addEventListener('submit', function(e) {
            if (qInput.value.trim() === '') {
                e.preventDefault();
                return false;
            }

            btnSend.disabled = true;
            btnSend.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i>';

            const userMsg = qInput.value;

            setTimeout(() => {
                qInput.value = '';
                qInput.style.height = 'auto';
            }, 10);

            const now = new Date();
            const timeStr = now.getHours().toString().padStart(2, '0') + ':' + now.getMinutes().toString().padStart(2, '0');

            const userHtml = `
            <div class="msg-row user">
                <div class="msg-avatar"><i class="fa-solid fa-user"></i></div>
                <div class="msg-body">
                    <div class="msg-bubble">${userMsg.replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\n/g, '<br>')}</div>
                    <div class="msg-time">${timeStr}</div>
                </div>
            </div>`;

            const typingHtml = `
            <div class="msg-row bot">
                <div class="msg-avatar"><i class="fa-solid fa-robot"></i></div>
                <div class="msg-body">
                    <div class="msg-bubble" style="padding: 0.6rem 1rem;">
                        <div class="typing-dots"><span></span><span></span><span></span></div>
                    </div>
                </div>
            </div>`;

            const emptyState = document.querySelector('.chat-empty');
            if (emptyState) emptyState.remove();

            msgContainer.insertAdjacentHTML('beforeend', userHtml + typingHtml);
            scrollToBottom();
        });

        scrollToBottom();
    </script>
}