@page
@model PresentationLayer.Pages.Benchmark.IndexModel
@{
    ViewData["Title"] = "Benchmark Studio";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-chart-line me-2 text-primary"></i> Benchmark Studio</h2>
    </div>

    <div class="row">
        <!-- Danh sách môn học và bộ đề -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="fas fa-book me-2"></i> Môn học & Bộ Đề</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Chọn môn học để Import bộ đề hoặc chạy Benchmark.</p>
                    <ul class="list-group">
                        @foreach(var sub in Model.Subjects)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@sub.Code</strong> - @sub.Name
                                    <br />
                                    <small class="text-muted">Đang có: @sub.TestQuestions.Count câu hỏi test</small>
                                </div>
                                <div>
                                    <a href="/Benchmark/Import?subjectId=@sub.Id" class="btn btn-sm btn-outline-primary" title="Import câu hỏi">
                                        <i class="fas fa-upload"></i>
                                    </a>
                                    <a href="/Benchmark/Questions?subjectId=@sub.Id" class="btn btn-sm btn-outline-info ms-1" title="Quản lý câu hỏi">
                                        <i class="fas fa-list-check"></i>
                                    </a>
                                    @if(sub.TestQuestions.Count > 0)
                                    {
                                        <a href="/Benchmark/Run?subjectId=@sub.Id" class="btn btn-sm btn-success ms-1" title="Chạy Benchmark">
                                            <i class="fas fa-play"></i>
                                        </a>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <!-- Danh sách các lượt chạy (Experiment Runs) -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="fas fa-history me-2"></i> Lịch sử Đánh giá</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Tên Benchmark</th>
                                    <th>Trạng thái</th>
                                    <th>Thời gian</th>
                                    <th>Chi tiết</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var run in Model.Runs)
                                {
                                    <tr>
                                        <td>#@run.Id</td>
                                        <td>@run.RunName</td>
                                        <td>
                                            @if(run.Status == "done")
                                            {
                                                <span class="badge bg-success">Hoàn thành</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">@run.Status</span>
                                            }
                                        </td>
                                        <td>@run.StartedAt?.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                            <a href="/Benchmark/Result?runId=@run.Id" class="btn btn-sm btn-info text-white">
                                                <i class="fas fa-eye"></i> Xem
                                            </a>
                                        </td>
                                    </tr>
                                }
                                @if(!Model.Runs.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted">Chưa có lịch sử chạy benchmark nào.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
