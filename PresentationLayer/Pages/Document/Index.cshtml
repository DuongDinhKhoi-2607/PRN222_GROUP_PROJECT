@page
@model PresentationLayer.Pages.Document.IndexModel
@{
    ViewData["Title"] = "Quản lý Tài liệu";
}

<style>
.crud-page { height: 100%; overflow-y: auto; padding: 2rem; }
.crud-page::-webkit-scrollbar { width: 4px; }
.crud-page::-webkit-scrollbar-thumb { background: var(--border-strong); border-radius: 4px; }

.page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem; }
.page-heading { font-size: 1.4rem; font-weight: 700; background: linear-gradient(135deg, #fff, var(--accent-2)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; display: flex; align-items: center; gap: .65rem; }
.page-heading i { -webkit-text-fill-color: var(--accent-2); }

.btn-add { display: inline-flex; align-items: center; gap: .5rem; padding: .6rem 1.25rem; background: linear-gradient(135deg, var(--accent-2), #00b090); border: none; border-radius: var(--radius-sm); color: #fff; font-size: .85rem; font-weight: 600; font-family: 'Inter', sans-serif; cursor: pointer; text-decoration: none; transition: all var(--transition); box-shadow: 0 4px 16px var(--accent-2-glow); }
.btn-add:hover { transform: translateY(-1px); box-shadow: 0 8px 24px var(--accent-2-glow); color: #fff; }

.alert-success-bar { display: flex; align-items: center; gap: .75rem; padding: .85rem 1.25rem; background: rgba(0,212,170,.1); border: 1px solid rgba(0,212,170,.25); border-radius: var(--radius-md); color: var(--accent-2); font-size: .85rem; margin-bottom: 1.5rem; animation: msg-in .25s ease; }
.alert-error-bar { display: flex; align-items: center; gap: .75rem; padding: .85rem 1.25rem; background: rgba(255,77,109,.1); border: 1px solid rgba(255,77,109,.25); border-radius: var(--radius-md); color: var(--accent-danger); font-size: .85rem; margin-bottom: 1.5rem; animation: msg-in .25s ease; }

.empty-state { text-align: center; padding: 4rem 2rem; color: var(--text-muted); }
.empty-state i { font-size: 3rem; margin-bottom: 1rem; display: block; opacity: .3; }

.data-table { width: 100%; border-collapse: separate; border-spacing: 0; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; }
.data-table thead tr { background: var(--bg-elevated); }
.data-table th { padding: .9rem 1.25rem; font-size: .72rem; font-weight: 600; text-transform: uppercase; letter-spacing: .07em; color: var(--text-muted); text-align: left; border-bottom: 1px solid var(--border); }
.data-table td { padding: .85rem 1.25rem; font-size: .875rem; color: var(--text-primary); border-bottom: 1px solid var(--border); vertical-align: middle; }
.data-table tbody tr:last-child td { border-bottom: none; }
.data-table tbody tr { transition: background var(--transition); }
.data-table tbody tr:hover { background: var(--bg-hover); }

.badge-subject { display: inline-flex; align-items: center; gap: .3rem; padding: .2rem .6rem; background: rgba(108,99,255,.12); border: 1px solid rgba(108,99,255,.25); border-radius: 999px; font-size: .7rem; font-weight: 600; color: #a78bfa; }
.status-pill { display: inline-flex; align-items: center; gap: .3rem; padding: .22rem .65rem; border-radius: 999px; font-size: .72rem; font-weight: 600; }
.status-pill.indexed { background: rgba(0,212,170,.12); border: 1px solid rgba(0,212,170,.25); color: var(--accent-2); }
.status-pill.pending { background: rgba(255,183,3,.1); border: 1px solid rgba(255,183,3,.2); color: var(--accent-warn); }
.status-pill.error   { background: rgba(255,77,109,.1); border: 1px solid rgba(255,77,109,.2); color: var(--accent-danger); }
.file-chip { font-size: .73rem; color: var(--text-muted); background: var(--bg-elevated); border: 1px solid var(--border); border-radius: 4px; padding: .1rem .4rem; }

.action-group { display: flex; gap: .4rem; align-items: center; }
.btn-action { width: 30px; height: 30px; display: inline-flex; align-items: center; justify-content: center; border-radius: var(--radius-sm); border: 1px solid var(--border); background: var(--bg-elevated); color: var(--text-secondary); font-size: .8rem; text-decoration: none; transition: all var(--transition); cursor: pointer; }
.btn-action.view:hover  { background: rgba(0,212,170,.15); border-color: rgba(0,212,170,.4); color: var(--accent-2); }
.btn-action.edit:hover  { background: rgba(255,183,3,.15); border-color: rgba(255,183,3,.4); color: var(--accent-warn); }
.btn-action.delete:hover { background: rgba(255,77,109,.15); border-color: rgba(255,77,109,.4); color: var(--accent-danger); }

.no-permission-hint { font-size: .7rem; color: var(--text-muted); font-style: italic; }
</style>

<div class="crud-page">
    <div class="page-header">
        <h1 class="page-heading">
            <i class="fa-solid fa-folder-open"></i>
            Quản lý Tài liệu
        </h1>
        <div style="display: flex; gap: 1rem; align-items: center;">
            <form method="get" style="display: flex; align-items: center; gap: .5rem;">
                <select asp-for="SubjectId" name="subjectId" class="form-select" style="padding: .5rem; border-radius: var(--radius-sm); border: 1px solid var(--border); background: var(--bg-elevated); color: var(--text-primary); font-size: .85rem;" onchange="this.form.submit()">
                    <option value="">-- Tất cả môn học --</option>
                    @if (Model.Subjects != null)
                    {
                        foreach (var s in Model.Subjects)
                        {
                            <option value="@s.Id">@s.Code - @s.Name</option>
                        }
                    }
                </select>
            </form>
            @if (!Model.IsAdmin && Model.AllowedSubjectIds.Any())
            {
                <a asp-page="Upload" asp-route-returnUrl="@Model.CurrentUrl" class="btn-add">
                    <i class="fa-solid fa-cloud-arrow-up"></i> Upload tài liệu
                </a>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-success-bar">
            <i class="fa-solid fa-circle-check"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-error-bar">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <div class="card" id="emptyStateCard" style="@(Model.Documents.Any() ? "display: none;" : "")">
        <div class="empty-state">
            <i class="fa-solid fa-file-circle-xmark"></i>
            <p>Chưa có tài liệu nào. Hãy upload tài liệu đầu tiên!</p>
        </div>
    </div>

    <table class="data-table" id="documentTable" style="@(Model.Documents.Any() ? "" : "display: none;")">
        <thead>
            <tr>
                <th>Tiêu đề</th>
                <th>File</th>
                <th>Môn học</th>
                <th>Trạng thái</th>
                <th>Người upload</th>
                <th>Ngày upload</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody id="documentTableBody">
            @foreach (var d in Model.Documents)
            {
                var canEdit = Model.IsAdmin || Model.AllowedSubjectIds.Contains(d.SubjectId);
                <tr id="doc-row-@d.Id" data-subject-id="@d.SubjectId">
                    <td style="font-weight:500;max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="@d.Title">@d.Title</td>
                    <td>
                        <div style="display:flex;align-items:center;gap:.4rem">
                            <span class="file-chip">@d.FileType</span>
                            <span style="font-size:.78rem;color:var(--text-muted);max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="@d.FileName">@d.FileName</span>
                        </div>
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(d.SubjectCode))
                        {
                            <span class="badge-subject"><i class="fa-solid fa-book" style="font-size:.65rem"></i>@d.SubjectCode</span>
                        }
                    </td>
                    <td>
                        @if (d.Status == "indexed" || d.Status == "ready")
                        { <span class="status-pill indexed"><i class="fa-solid fa-circle-check"></i>Indexed</span> }
                        else if (d.Status == "error")
                        { <span class="status-pill error"><i class="fa-solid fa-circle-xmark"></i>Error</span> }
                        else
                        { <span class="status-pill pending"><i class="fa-solid fa-clock"></i>Pending</span> }
                    </td>
                    <td style="font-size:.8rem;color:var(--text-secondary)">@(d.UploadedByName ?? "Không rõ")</td>
                    <td style="font-size:.8rem;color:var(--text-muted)">@(d.UploadedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                    <td>
                        <div class="action-group">
                            <a asp-page="Details" asp-route-id="@d.Id" asp-route-returnUrl="@Model.CurrentUrl" class="btn-action view" title="Chi tiết">
                                <i class="fa-solid fa-eye"></i>
                            </a>
                            @if (canEdit)
                            {
                                <a asp-page="Edit" asp-route-id="@d.Id" asp-route-returnUrl="@Model.CurrentUrl" class="btn-action edit" title="Sửa">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                <a asp-page="Delete" asp-route-id="@d.Id" asp-route-returnUrl="@Model.CurrentUrl" class="btn-action delete" title="Xóa">
                                    <i class="fa-solid fa-trash"></i>
                                </a>
                            }
                            else
                            {
                                <span class="no-permission-hint" title="Liên hệ Admin để được cấp quyền">
                                    <i class="fa-solid fa-lock" style="font-size:.65rem"></i>
                                </span>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        const isAdmin = @Model.IsAdmin.ToString().ToLower();
        const allowedSubjectIds = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AllowedSubjectIds));
        const currentSubjectFilter = @(Model.SubjectId.HasValue ? Model.SubjectId.Value.ToString() : "null");

        const connection = window.hubConnection || new signalR.HubConnectionBuilder()
            .withUrl("/documentHub")
            .withAutomaticReconnect()
            .build();

        // Hàm thêm một dòng tài liệu mới vào bảng (chỉ gọi khi tài liệu đã indexed hoặc ready)
        function addNewDocumentRow(doc) {
            // Nếu người dùng đang lọc theo môn học và tài liệu mới không thuộc môn học đó, bỏ qua
            if (currentSubjectFilter !== null && doc.subjectId !== currentSubjectFilter) {
                return;
            }

            // Ẩn trạng thái trống và hiển thị bảng
            const emptyState = document.getElementById("emptyStateCard");
            if (emptyState) {
                emptyState.style.display = "none";
            }
            
            const table = document.getElementById("documentTable");
            if (table) {
                table.style.display = "table";
            }

            const tbody = document.getElementById("documentTableBody");
            if (tbody) {
                // Nếu dòng đã tồn tại, tránh thêm trùng lặp
                if (document.getElementById(`doc-row-${doc.id}`)) {
                    return;
                }

                const canEdit = isAdmin || allowedSubjectIds.includes(doc.subjectId);
                const tr = document.createElement("tr");
                tr.id = `doc-row-${doc.id}`;
                tr.setAttribute("data-subject-id", doc.subjectId);

                const titleHtml = `<td style="font-weight:500;max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${escapeHtml(doc.title)}">${escapeHtml(doc.title)}</td>`;
                const fileHtml = `
                    <td>
                        <div style="display:flex;align-items:center;gap:.4rem">
                            <span class="file-chip">${escapeHtml(doc.fileType)}</span>
                            <span style="font-size:.78rem;color:var(--text-muted);max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${escapeHtml(doc.fileName)}">${escapeHtml(doc.fileName)}</span>
                        </div>
                    </td>`;
                const subjectHtml = `
                    <td>
                        ${doc.subjectCode ? `<span class="badge-subject"><i class="fa-solid fa-book" style="font-size:.65rem"></i>${escapeHtml(doc.subjectCode)}</span>` : ''}
                    </td>`;
                
                // Vì ta chỉ hiển thị khi gửi thành công (indexed hoặc ready)
                let statusClass = "indexed";
                let statusIcon = "fa-circle-check";
                let statusText = "Indexed";
                const statusHtml = `
                    <td>
                        <span class="status-pill ${statusClass}"><i class="fa-solid ${statusIcon}"></i>${statusText}</span>
                    </td>`;

                const uploadedByHtml = `<td style="font-size:.8rem;color:var(--text-secondary)">${escapeHtml(doc.uploadedByName || "Không rõ")}</td>`;
                const uploadedAtHtml = `<td style="font-size:.8rem;color:var(--text-muted)">${formatDateTime(doc.uploadedAt)}</td>`;

                const returnUrl = encodeURIComponent(window.location.pathname + window.location.search);
                let actionHtml = '';
                if (canEdit) {
                    actionHtml = `
                        <div class="action-group">
                            <a href="/Document/Details?id=${doc.id}&returnUrl=${returnUrl}" class="btn-action view" title="Chi tiết">
                                <i class="fa-solid fa-eye"></i>
                            </a>
                            <a href="/Document/Edit?id=${doc.id}&returnUrl=${returnUrl}" class="btn-action edit" title="Sửa">
                                <i class="fa-solid fa-pen"></i>
                            </a>
                            <a href="/Document/Delete?id=${doc.id}&returnUrl=${returnUrl}" class="btn-action delete" title="Xóa">
                                <i class="fa-solid fa-trash"></i>
                            </a>
                        </div>`;
                } else {
                    actionHtml = `
                        <div class="action-group">
                            <a href="/Document/Details?id=${doc.id}&returnUrl=${returnUrl}" class="btn-action view" title="Chi tiết">
                                <i class="fa-solid fa-eye"></i>
                            </a>
                            <span class="no-permission-hint" title="Liên hệ Admin để được cấp quyền">
                                <i class="fa-solid fa-lock" style="font-size:.65rem"></i>
                            </span>
                        </div>`;
                }
                const actionsCell = `<td>${actionHtml}</td>`;

                tr.innerHTML = titleHtml + fileHtml + subjectHtml + statusHtml + uploadedByHtml + uploadedAtHtml + actionsCell;
                
                // Thêm dòng mới vào cuối bảng
                tbody.appendChild(tr);
                
                // Hiệu ứng làm nổi bật dòng mới thêm vào
                tr.style.transition = "background-color 1s ease";
                tr.style.backgroundColor = "rgba(0, 212, 170, 0.15)";
                setTimeout(() => {
                    tr.style.backgroundColor = "";
                }, 2000);
            }
        }

        connection.on("ReceiveNewDocument", function (doc) {
            console.log("New document received via SignalR: ", doc);
            
            // Chỉ hiển thị các tài liệu đã xử lý thành công (indexed hoặc ready)
            if (doc.status === "indexed" || doc.status === "ready") {
                addNewDocumentRow(doc);
            }
        });

        connection.on("ReceiveDeletedDocument", function (id) {
            console.log("Document deleted via SignalR: ", id);
            const row = document.getElementById(`doc-row-${id}`);
            if (row) {
                row.style.transition = "all 0.5s ease";
                row.style.backgroundColor = "rgba(255, 77, 109, 0.2)";
                row.style.opacity = "0";
                setTimeout(() => {
                    row.remove();
                    
                    const tbody = document.getElementById("documentTableBody");
                    if (tbody && tbody.children.length === 0) {
                        const emptyState = document.getElementById("emptyStateCard");
                        if (emptyState) {
                            emptyState.style.display = "block";
                        }
                        const table = document.getElementById("documentTable");
                        if (table) {
                            table.style.display = "none";
                        }
                    }
                }, 500);
            }
        });

        connection.on("ReceiveUpdatedDocument", function (doc) {
            console.log("Document updated via SignalR: ", doc);
            
            const isSuccess = doc.status === "indexed" || doc.status === "ready";
            const matchesFilter = currentSubjectFilter === null || doc.subjectId === currentSubjectFilter;
            const row = document.getElementById(`doc-row-${doc.id}`);
            
            // Nếu tài liệu không thành công hoặc không khớp bộ lọc nữa, ẩn/xóa nó khỏi danh sách
            if (!isSuccess || !matchesFilter) {
                if (row) {
                    row.remove();
                    const tbody = document.getElementById("documentTableBody");
                    if (tbody && tbody.children.length === 0) {
                        const emptyState = document.getElementById("emptyStateCard");
                        if (emptyState) {
                            emptyState.style.display = "block";
                        }
                        const table = document.getElementById("documentTable");
                        if (table) {
                            table.style.display = "none";
                        }
                    }
                }
                return;
            }

            if (row) {
                row.setAttribute("data-subject-id", doc.subjectId);
                
                // Cập nhật các cột
                row.cells[0].textContent = doc.title;
                row.cells[0].title = doc.title;
                
                row.cells[1].innerHTML = `
                    <div style="display:flex;align-items:center;gap:.4rem">
                        <span class="file-chip">${escapeHtml(doc.fileType)}</span>
                        <span style="font-size:.78rem;color:var(--text-muted);max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${escapeHtml(doc.fileName)}">${escapeHtml(doc.fileName)}</span>
                    </div>`;

                row.cells[2].innerHTML = doc.subjectCode ? `<span class="badge-subject"><i class="fa-solid fa-book" style="font-size:.65rem"></i>${escapeHtml(doc.subjectCode)}</span>` : '';

                // Chỉ cập nhật trạng thái nếu nó ở trạng thái thành công
                row.cells[3].innerHTML = `<span class="status-pill indexed"><i class="fa-solid fa-circle-check"></i>Indexed</span>`;

                const canEdit = isAdmin || allowedSubjectIds.includes(doc.subjectId);
                const returnUrl = encodeURIComponent(window.location.pathname + window.location.search);
                let actionHtml = '';
                if (canEdit) {
                    actionHtml = `
                        <div class="action-group">
                            <a href="/Document/Details?id=${doc.id}&returnUrl=${returnUrl}" class="btn-action view" title="Chi tiết">
                                <i class="fa-solid fa-eye"></i>
                            </a>
                            <a href="/Document/Edit?id=${doc.id}&returnUrl=${returnUrl}" class="btn-action edit" title="Sửa">
                                <i class="fa-solid fa-pen"></i>
                            </a>
                            <a href="/Document/Delete?id=${doc.id}&returnUrl=${returnUrl}" class="btn-action delete" title="Xóa">
                                <i class="fa-solid fa-trash"></i>
                            </a>
                        </div>`;
                } else {
                    actionHtml = `
                        <div class="action-group">
                            <a href="/Document/Details?id=${doc.id}&returnUrl=${returnUrl}" class="btn-action view" title="Chi tiết">
                                <i class="fa-solid fa-eye"></i>
                            </a>
                            <span class="no-permission-hint" title="Liên hệ Admin để được cấp quyền">
                                <i class="fa-solid fa-lock" style="font-size:.65rem"></i>
                            </span>
                        </div>`;
                }
                row.cells[6].innerHTML = actionHtml;

                // Hiệu ứng làm nổi bật dòng vừa được cập nhật
                row.style.transition = "background-color 1s ease";
                row.style.backgroundColor = "rgba(255, 183, 3, 0.15)";
                setTimeout(() => {
                    row.style.backgroundColor = "";
                }, 2000);
            } else {
                // Nếu chưa có trong bảng (ví dụ: vừa được xử lý thành công chuyển từ pending sang indexed)
                addNewDocumentRow(doc);
            }
        });

        function escapeHtml(str) {
            if (!str) return "";
            return str
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        function formatDateTime(dateStr) {
            if (!dateStr) return "—";
            const d = new Date(dateStr);
            if (isNaN(d.getTime())) return "—";
            const day = String(d.getDate()).padStart(2, '0');
            const month = String(d.getMonth() + 1).padStart(2, '0');
            const year = d.getFullYear();
            const hours = String(d.getHours()).padStart(2, '0');
            const minutes = String(d.getMinutes()).padStart(2, '0');
            return `${day}/${month}/${year} ${hours}:${minutes}`;
        }

        if (connection.state === signalR.HubConnectionState.Disconnected) {
            connection.start().then(function () {
                console.log("SignalR: Connected to DocumentHub!");
            }).catch(function (err) {
                console.error("SignalR Connection Error: ", err.toString());
            });
        }
    </script>
}
