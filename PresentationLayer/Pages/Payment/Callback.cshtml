@page
@model PresentationLayer.Pages.Payment.CallbackModel
@{
    ViewData["Title"] = "Kết Quả Thanh Toán";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            @if (Model.ResponseModel.Success && Model.ResponseModel.VnPayResponseCode == "00")
            {
                <div class="alert alert-success shadow-sm p-5 rounded-3">
                    <div class="mb-4">
                        <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                    </div>
                    <h2 class="alert-heading fw-bold mb-3">Thanh Toán Thành Công!</h2>
                    <p class="fs-5 text-muted mb-4">Cảm ơn bạn đã sử dụng dịch vụ của chúng tôi.</p>
                    
                    <div class="bg-white p-3 rounded text-start mb-4 border">
                        <p class="mb-1"><strong>Mã đơn hàng:</strong> @Model.ResponseModel.OrderId</p>
                        <p class="mb-1"><strong>Mã giao dịch:</strong> @Model.ResponseModel.TransactionId</p>
                        <p class="mb-0"><strong>Thông tin:</strong> @Model.ResponseModel.OrderDescription</p>
                    </div>

                    <a href="/" class="btn btn-primary px-4 py-2">Về Trang Chủ</a>
                </div>
            }
            else
            {
                <div class="alert alert-danger shadow-sm p-5 rounded-3">
                    <div class="mb-4">
                        <i class="bi bi-x-circle-fill text-danger" style="font-size: 4rem;"></i>
                    </div>
                    <h2 class="alert-heading fw-bold mb-3">Thanh Toán Thất Bại / Đã Hủy</h2>
                    <p class="fs-5 text-muted mb-4">Giao dịch của bạn không thể hoàn tất hoặc đã bị hủy.</p>
                    
                    <div class="bg-white p-3 rounded text-start mb-4 border text-danger">
                        <p class="mb-1"><strong>Mã đơn hàng:</strong> @Model.ResponseModel.OrderId</p>
                        <p class="mb-0"><strong>Mã lỗi VNPay:</strong> @Model.ResponseModel.VnPayResponseCode</p>
                    </div>

                    <a href="/Upgrade" class="btn btn-outline-danger px-4 py-2 me-2">Thử Lại</a>
                    <a href="/" class="btn btn-secondary px-4 py-2">Về Trang Chủ</a>
                </div>
            }
        </div>
    </div>
</div>

<!-- Thêm Bootstrap Icons nếu chưa có -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
