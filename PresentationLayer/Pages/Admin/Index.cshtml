@page
@model PresentationLayer.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Quản lý Hệ thống";
}

<style>
.crud-page { height: 100%; overflow-y: auto; padding: 2rem; }
.crud-page::-webkit-scrollbar { width: 4px; }
.crud-page::-webkit-scrollbar-thumb { background: var(--border-strong); border-radius: 4px; }

.page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem; }
.page-heading { font-size: 1.4rem; font-weight: 700; background: linear-gradient(135deg, #fff, #a78bfa); -webkit-background-clip: text; -webkit-text-fill-color: transparent; display: flex; align-items: center; gap: .65rem; }
.page-heading i { -webkit-text-fill-color: #a78bfa; }

/* Tabs Styling */
.tab-nav { display: flex; gap: 0.5rem; border-bottom: 1px solid var(--border); margin-bottom: 1.5rem; }
.tab-btn { background: none; border: none; border-bottom: 2px solid transparent; color: var(--text-muted); padding: .75rem 1.25rem; font-size: .85rem; font-weight: 600; cursor: pointer; transition: all var(--transition); font-family: 'Inter', sans-serif; display: flex; align-items: center; gap: 0.5rem; }
.tab-btn:hover { color: var(--text-primary); }
.tab-btn.active { color: #a78bfa; border-bottom-color: #a78bfa; }
.tab-content { display: none; }
.tab-content.active { display: block; }

.section-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 0.75rem; }
.section-title { font-size: 1.1rem; font-weight: 600; color: var(--text-primary); display: flex; align-items: center; gap: 0.5rem; }

.btn-add { display: inline-flex; align-items: center; gap: .5rem; padding: .55rem 1.1rem; background: linear-gradient(135deg, var(--accent), #a78bfa); border: none; border-radius: var(--radius-sm); color: #fff; font-size: .8rem; font-weight: 600; font-family: 'Inter', sans-serif; cursor: pointer; text-decoration: none; transition: all var(--transition); box-shadow: 0 4px 16px var(--accent-glow); }
.btn-add:hover { transform: translateY(-1px); box-shadow: 0 8px 24px var(--accent-glow); color: #fff; }

.alert-bar { display: flex; align-items: center; gap: .75rem; padding: .85rem 1.25rem; border-radius: var(--radius-md); font-size: .85rem; margin-bottom: 1.5rem; animation: msg-in .25s ease; }
.alert-success-bar { background: rgba(0,212,170,.1); border: 1px solid rgba(0,212,170,.25); color: var(--accent-2); }
.alert-error-bar { background: rgba(255,77,109,.1); border: 1px solid rgba(255,77,109,.25); color: var(--accent-danger); }

@@keyframes msg-in {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
}

.empty-state { text-align: center; padding: 4rem 2rem; color: var(--text-muted); }
.empty-state i { font-size: 3rem; margin-bottom: 1rem; display: block; opacity: .3; }

/* Table Styling */
.data-table { width: 100%; border-collapse: separate; border-spacing: 0; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; margin-bottom: 2rem; }
.data-table thead tr { background: var(--bg-elevated); }
.data-table th { padding: .9rem 1.25rem; font-size: .72rem; font-weight: 600; text-transform: uppercase; letter-spacing: .07em; color: var(--text-muted); text-align: left; border-bottom: 1px solid var(--border); }
.data-table td { padding: .85rem 1.25rem; font-size: .875rem; color: var(--text-primary); border-bottom: 1px solid var(--border); vertical-align: middle; }
.data-table tbody tr:last-child td { border-bottom: none; }
.data-table tbody tr { transition: background var(--transition); }
.data-table tbody tr:hover { background: var(--bg-hover); }

/* Badges */
.badge-lecturer { display: inline-flex; align-items: center; gap: .35rem; padding: .2rem .6rem; background: rgba(108,99,255,.12); border: 1px solid rgba(108,99,255,.25); border-radius: 999px; font-size: .75rem; font-weight: 600; color: #a78bfa; }
.badge-student { display: inline-flex; align-items: center; gap: .35rem; padding: .2rem .6rem; background: rgba(0,212,170,.12); border: 1px solid rgba(0,212,170,.25); border-radius: 999px; font-size: .75rem; font-weight: 600; color: var(--accent-2); }
.badge-subject { display: inline-flex; align-items: center; gap: .3rem; padding: .2rem .6rem; background: rgba(0,212,170,.12); border: 1px solid rgba(0,212,170,.25); border-radius: 999px; font-size: .75rem; font-weight: 600; color: var(--accent-2); }

.badge-status { display: inline-flex; align-items: center; gap: .3rem; padding: .2rem .55rem; border-radius: 999px; font-size: .72rem; font-weight: 600; }
.badge-status.active { background: rgba(0,212,170,.12); border: 1px solid rgba(0,212,170,.25); color: var(--accent-2); }
.badge-status.inactive { background: rgba(255,183,3,.12); border: 1px solid rgba(255,183,3,.25); color: var(--accent-warn); }

/* Actions buttons */
.btn-delete { display: inline-flex; align-items: center; gap: .35rem; padding: .35rem .75rem; background: rgba(255,77,109,.1); border: 1px solid rgba(255,77,109,.25); border-radius: var(--radius-sm); color: var(--accent-danger); font-size: .78rem; font-weight: 600; font-family: 'Inter', sans-serif; cursor: pointer; transition: all var(--transition); }
.btn-delete:hover { background: rgba(255,77,109,.2); border-color: rgba(255,77,109,.5); transform: translateY(-1px); }

.btn-revoke { display: inline-flex; align-items: center; gap: .35rem; padding: .35rem .75rem; background: rgba(255,183,3,.1); border: 1px solid rgba(255,183,3,.25); border-radius: var(--radius-sm); color: var(--accent-warn); font-size: .78rem; font-weight: 600; font-family: 'Inter', sans-serif; cursor: pointer; transition: all var(--transition); }
.btn-revoke:hover { background: rgba(255,183,3,.2); border-color: rgba(255,183,3,.5); transform: translateY(-1px); }

/* Stats cards styling */
.stats-row { display: flex; gap: 1rem; margin-bottom: 1.5rem; }
.stat-card { flex: 1; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 1rem 1.25rem; display: flex; align-items: center; gap: 1rem; }
.stat-icon { width: 40px; height: 40px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; font-size: 1.1rem; }
.stat-icon.purple { background: rgba(108,99,255,.15); color: var(--accent); }
.stat-icon.teal { background: rgba(0,212,170,.12); color: var(--accent-2); }
.stat-icon.amber { background: rgba(255,183,3,.12); color: var(--accent-warn); }
.stat-value { font-size: 1.35rem; font-weight: 700; color: var(--text-primary); }
.stat-label { font-size: .7rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: .05em; margin-top: .15rem; }
</style>

<div class="crud-page">
    <div class="page-header">
        <h1 class="page-heading">
            <i class="fa-solid fa-user-shield"></i>
            Quản trị Hệ thống
        </h1>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-bar alert-success-bar">
            <i class="fa-solid fa-circle-check"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-bar alert-error-bar">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Tab navigation -->
    <div class="tab-nav">
        <button class="tab-btn active" data-tab="lecturers" onclick="switchTab('lecturers')">
            <i class="fa-solid fa-chalkboard-user"></i>
            Giảng viên
        </button>
        <button class="tab-btn" data-tab="students" onclick="switchTab('students')">
            <i class="fa-solid fa-graduation-cap"></i>
            Sinh viên
        </button>
        <button class="tab-btn" data-tab="permissions" onclick="switchTab('permissions')">
            <i class="fa-solid fa-key"></i>
            Phân quyền Môn học
        </button>
    </div>

    <!-- ==================== TAB: GIẢNG VIÊN ==================== -->
    <div id="lecturers" class="tab-content active">
        <div class="section-header">
            <div class="section-title">
                <i class="fa-solid fa-users-gear" style="color: #a78bfa;"></i>
                Danh sách tài khoản Giảng viên
            </div>
            <a asp-page="CreateLecturer" class="btn-add">
                <i class="fa-solid fa-user-plus"></i> Tạo Giảng viên
            </a>
        </div>

        @if (Model.Lecturers == null || !Model.Lecturers.Any())
        {
            <div class="card">
                <div class="empty-state">
                    <i class="fa-solid fa-chalkboard-user"></i>
                    <p>Chưa có tài khoản giảng viên nào trong hệ thống.</p>
                </div>
            </div>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Họ và Tên</th>
                        <th>Email đăng nhập</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th style="width: 120px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Model.Lecturers)
                    {
                        <tr>
                            <td>
                                <span class="badge-lecturer">
                                    <i class="fa-solid fa-chalkboard-user" style="font-size:.65rem"></i>
                                    @l.FullName
                                </span>
                            </td>
                            <td style="color: var(--text-secondary); font-size: .85rem;">@l.Email</td>
                            <td>
                                @if (l.IsActive == true)
                                {
                                    <span class="badge-status active">
                                        <span class="status-dot"></span>
                                        Đang hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-status inactive">
                                        <span class="status-dot" style="background-color: var(--accent-warn);"></span>
                                        Chờ kích hoạt
                                    </span>
                                }
                            </td>
                            <td style="color: var(--text-muted); font-size: .8rem;">
                                @(l.CreatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                            </td>
                            <td>
                                <form asp-page-handler="DeleteUser" asp-route-id="@l.Id" method="post" style="display:inline"
                                      onsubmit="return confirm('CẢNH BÁO: Xóa giảng viên này sẽ xóa tất cả phân quyền và phiên chat liên quan! Bạn có chắc chắn muốn xóa?')">
                                    <button type="submit" class="btn-delete">
                                        <i class="fa-solid fa-trash-can"></i> Xóa
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <!-- ==================== TAB: SINH VIÊN ==================== -->
    <div id="students" class="tab-content">
        <div class="section-header">
            <div class="section-title">
                <i class="fa-solid fa-users" style="color: var(--accent-2);"></i>
                Danh sách tài khoản Sinh viên
            </div>
        </div>

        @if (Model.Students == null || !Model.Students.Any())
        {
            <div class="card">
                <div class="empty-state">
                    <i class="fa-solid fa-graduation-cap"></i>
                    <p>Chưa có tài khoản sinh viên nào trong hệ thống.</p>
                </div>
            </div>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Họ và Tên</th>
                        <th>Email đăng nhập</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th style="width: 120px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Students)
                    {
                        <tr>
                            <td>
                                <span class="badge-student">
                                    <i class="fa-solid fa-graduation-cap" style="font-size:.65rem"></i>
                                    @s.FullName
                                </span>
                            </td>
                            <td style="color: var(--text-secondary); font-size: .85rem;">@s.Email</td>
                            <td>
                                <span class="badge-status active">
                                    <span class="status-dot"></span>
                                    Đang hoạt động
                                </span>
                            </td>
                            <td style="color: var(--text-muted); font-size: .8rem;">
                                @(s.CreatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                            </td>
                            <td>
                                <form asp-page-handler="DeleteUser" asp-route-id="@s.Id" method="post" style="display:inline"
                                      onsubmit="return confirm('Bạn có chắc chắn muốn xóa vĩnh viễn tài khoản sinh viên này và mọi cuộc trò chuyện liên quan?')">
                                    <button type="submit" class="btn-delete">
                                        <i class="fa-solid fa-trash-can"></i> Xóa
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <!-- ==================== TAB: PHÂN QUYỀN MÔN HỌC ==================== -->
    <div id="permissions" class="tab-content">
        <div class="section-header">
            <div class="section-title">
                <i class="fa-solid fa-user-lock" style="color: var(--accent-2);"></i>
                Danh sách phân quyền giảng viên
            </div>
            <a asp-page="Grant" class="btn-add" style="background: linear-gradient(135deg, var(--accent-2), #00b090); box-shadow: 0 4px 16px rgba(0, 212, 170, 0.2);">
                <i class="fa-solid fa-plus"></i> Cấp quyền mới
            </a>
        </div>

        @{
            var permList = Model.Permissions.ToList();
            var totalPermissions = permList.Count;
            var uniqueLecturers = permList.Select(p => p.LecturerId).Distinct().Count();
            var uniqueSubjects = permList.Select(p => p.SubjectId).Distinct().Count();
        }

        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-icon purple">
                    <i class="fa-solid fa-key"></i>
                </div>
                <div>
                    <div class="stat-value">@totalPermissions</div>
                    <div class="stat-label">Tổng quyền đã cấp</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon teal">
                    <i class="fa-solid fa-chalkboard-user"></i>
                </div>
                <div>
                    <div class="stat-value">@uniqueLecturers</div>
                    <div class="stat-label">Giảng viên được cấp</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon amber">
                    <i class="fa-solid fa-book"></i>
                </div>
                <div>
                    <div class="stat-value">@uniqueSubjects</div>
                    <div class="stat-label">Môn học liên quan</div>
                </div>
            </div>
        </div>

        @if (!permList.Any())
        {
            <div class="card">
                <div class="empty-state">
                    <i class="fa-solid fa-shield-halved"></i>
                    <p>Chưa cấp quyền quản lý môn học cho giảng viên nào.</p>
                </div>
            </div>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Giảng viên</th>
                        <th>Email</th>
                        <th>Môn học</th>
                        <th>Ngày cấp</th>
                        <th>Cấp bởi</th>
                        <th style="width: 120px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in permList)
                    {
                        <tr>
                            <td>
                                <span class="badge-lecturer">
                                    <i class="fa-solid fa-chalkboard-user" style="font-size:.65rem"></i>
                                    @p.LecturerName
                                </span>
                            </td>
                            <td style="font-size:.8rem; color:var(--text-secondary)">@p.LecturerEmail</td>
                            <td>
                                <span class="badge-subject">
                                    <i class="fa-solid fa-book" style="font-size:.65rem"></i>
                                    @p.SubjectCode – @p.SubjectName
                                </span>
                            </td>
                            <td style="color:var(--text-muted);font-size:.78rem">@(p.GrantedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                            <td style="font-size:.8rem; color:var(--text-secondary)">@p.GrantedByName</td>
                            <td>
                                <form asp-page-handler="Revoke" asp-route-id="@p.Id" method="post" style="display:inline"
                                      onsubmit="return confirm('Bạn có chắc chắn muốn thu hồi quyền upload tài liệu của giảng viên này?')">
                                    <button type="submit" class="btn-revoke">
                                        <i class="fa-solid fa-ban"></i> Thu hồi
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<script>
    function switchTab(tabId) {
        document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
        
        document.querySelector(`[data-tab="${tabId}"]`).classList.add('active');
        document.getElementById(tabId).classList.add('active');
    }
</script>
