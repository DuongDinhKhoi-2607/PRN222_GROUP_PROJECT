@page
@model PresentationLayer.Pages.Auth.ChangePasswordModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<style>
    :root {
        --accent-purple: #6c63ff;
        --accent-purple-dark: #5850ec;
        --card-bg: #141822;
        --border-color: rgba(255, 255, 255, 0.08);
        --text-main: #ffffff;
        --text-muted: #94a3b8;
        --input-bg: rgba(255, 255, 255, 0.03);
        --transition-smooth: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    }

    .crud-page {
        min-height: calc(100vh - 80px);
        overflow-y: auto;
        padding: 2rem;
        position: relative;
        display: flex;
        align-items: flex-start;
        justify-content: center;
    }

    .bg-orb {
        position: absolute;
        width: 350px;
        height: 350px;
        background: var(--accent-purple);
        border-radius: 50%;
        filter: blur(120px);
        opacity: 0.1;
        top: 10%;
        right: 15%;
        z-index: 0;
        pointer-events: none;
    }

    .form-card {
        width: 100%;
        max-width: 500px;
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        overflow: hidden;
        z-index: 1;
        margin-top: 5vh;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }

    .form-card-header {
        padding: 1.5rem 2rem;
        border-bottom: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        gap: 1rem;
        background: rgba(255, 255, 255, 0.02);
    }

    .form-card-icon {
        width: 42px;
        height: 42px;
        background: linear-gradient(135deg, var(--accent-purple), var(--accent-purple-dark));
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 1.1rem;
        flex-shrink: 0;
    }

    .form-card-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--text-main);
    }

    .form-card-subtitle {
        font-size: 0.8rem;
        color: var(--text-muted);
        margin-top: 0.2rem;
    }

    .form-card-body {
        padding: 2rem;
    }

    .field-group {
        margin-bottom: 1.5rem;
    }

    .field-label {
        display: block;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-muted);
        margin-bottom: 0.6rem;
    }

    .field-label .req {
        color: #fb7185;
        margin-left: 0.2rem;
    }

    .field-input {
        width: 100%;
        background: var(--input-bg);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        color: var(--text-main);
        padding: 0.85rem 1rem;
        font-size: 0.95rem;
        font-family: 'Inter', sans-serif;
        transition: var(--transition-smooth);
    }

    .field-input:focus {
        outline: none;
        background: rgba(255, 255, 255, 0.05);
        border-color: var(--accent-purple);
        box-shadow: 0 0 0 2px rgba(108, 99, 255, 0.15);
    }

    .alert-err {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        padding: 0.9rem 1.25rem;
        background: rgba(244, 63, 94, 0.1);
        border: 1px solid rgba(244, 63, 94, 0.2);
        border-radius: 10px;
        color: #fb7185;
        font-size: 0.85rem;
        margin-bottom: 1.5rem;
        line-height: 1.5;
    }

    .alert-success-box {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        padding: 0.9rem 1.25rem;
        background: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(16, 185, 129, 0.2);
        border-radius: 10px;
        color: #34d399;
        font-size: 0.85rem;
        margin-bottom: 1.5rem;
        line-height: 1.5;
    }

    .form-actions {
        display: flex;
        gap: 1rem;
        padding: 1.25rem 2rem;
        border-top: 1px solid var(--border-color);
        background: rgba(255, 255, 255, 0.01);
    }

    .btn-submit {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        background: linear-gradient(135deg, var(--accent-purple), var(--accent-purple-dark));
        border: none;
        border-radius: 10px;
        color: #fff;
        font-size: 0.9rem;
        font-weight: 600;
        font-family: 'Inter', sans-serif;
        cursor: pointer;
        transition: var(--transition-smooth);
    }

    .btn-submit:hover {
        transform: translateY(-2px);
        background: linear-gradient(135deg, #7c75ff, #635bee);
    }

    .btn-cancel {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        background: transparent;
        border: 1px solid var(--border-color);
        border-radius: 10px;
        color: var(--text-muted);
        font-size: 0.9rem;
        font-weight: 600;
        font-family: 'Inter', sans-serif;
        cursor: pointer;
        transition: var(--transition-smooth);
        text-decoration: none;
    }

    .btn-cancel:hover {
        background: rgba(255, 255, 255, 0.05);
        color: var(--text-main);
    }
</style>

<div class="crud-page">
    <div class="bg-orb"></div>

    <div class="form-card">
        <div class="form-card-header">
            <div class="form-card-icon"><i class="fa-solid fa-key"></i></div>
            <div>
                <div class="form-card-title">Đổi mật khẩu</div>
                <div class="form-card-subtitle">Cập nhật mật khẩu tài khoản của bạn</div>
            </div>
        </div>

        <div class="form-card-body" style="padding-bottom: 0;">
            @if (Model.Forced)
            {
                <div class="alert-err">
                    <i class="fa-solid fa-triangle-exclamation" style="flex-shrink:0; margin-top: 0.15rem; font-size: 1.1rem;"></i>
                    <div>
                        <strong>Yêu cầu đổi mật khẩu:</strong> Bạn đang sử dụng mật khẩu mặc định được hệ thống tự động cấp. Vui lòng cập nhật mật khẩu mới có tính bảo mật cao hơn để tiếp tục sử dụng hệ thống!
                    </div>
                </div>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert-success-box">
                    <i class="fa-solid fa-circle-check" style="flex-shrink:0; margin-top: 0.15rem;"></i>
                    <div>@TempData["SuccessMessage"]</div>
                </div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert-err">
                    <i class="fa-solid fa-circle-exclamation" style="flex-shrink:0; margin-top: 0.15rem;"></i>
                    <div>
                        @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>@e.ErrorMessage</div>
                        }
                    </div>
                </div>
            }
        </div>

        <form method="post">
            <input type="hidden" asp-for="Forced" />
            <div class="form-card-body" style="padding-top: 0.5rem;">
                <div class="field-group">
                    <label class="field-label" asp-for="Input.CurrentPassword">Mật khẩu hiện tại <span class="req">*</span></label>
                    <input type="password" asp-for="Input.CurrentPassword" class="field-input" required placeholder="Nhập mật khẩu hiện tại" />
                </div>

                <div class="field-group">
                    <label class="field-label" asp-for="Input.NewPassword">Mật khẩu mới <span class="req">*</span></label>
                    <input type="password" asp-for="Input.NewPassword" class="field-input" required placeholder="Tối thiểu 6 ký tự" />
                </div>

                <div class="field-group" style="margin-bottom: 1.5rem;">
                    <label class="field-label" asp-for="Input.ConfirmNewPassword">Xác nhận mật khẩu mới <span class="req">*</span></label>
                    <input type="password" asp-for="Input.ConfirmNewPassword" class="field-input" required placeholder="Nhập lại mật khẩu mới" />
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-submit">
                    <i class="fa-solid fa-floppy-disk"></i> Đổi mật khẩu
                </button>
                @if (!Model.Forced)
                {
                    <a href="/Index" class="btn-cancel">
                        <i class="fa-solid fa-arrow-left"></i> Quay lại
                    </a>
                }
            </div>
        </form>
    </div>
</div>
