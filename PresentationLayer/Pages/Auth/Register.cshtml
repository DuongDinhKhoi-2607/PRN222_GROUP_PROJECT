@page
@model PresentationLayer.Pages.Auth.RegisterModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng ký tài khoản - RAG AI Assistant</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="/css/site.css" />
    <style>
            :root {
                --primary-glow: #00d4aa;
                --secondary-glow: #00b090;
                --bg-color: #0b0d14;
                --card-bg: rgba(20, 24, 34, 0.65);
                --border-color: rgba(255, 255, 255, 0.08);
                --text-main: #ffffff;
                --text-muted: #94a3b8;
                --input-bg: rgba(255, 255, 255, 0.03);
                --transition-smooth: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
            }

            * {
                box-sizing: border-box;
                font-family: 'Inter', sans-serif;
            }

            .auth-body {
                background-color: var(--bg-color);
                display: flex;
                align-items: center;
                justify-content: center;
                min-height: 100vh;
                overflow: hidden;
                margin: 0;
                padding: 1rem;
                position: relative;
            }

            /* Decorative Background Orbs */
            .bg-orb {
                position: absolute;
                border-radius: 50%;
                filter: blur(100px);
                opacity: 0.3;
                z-index: 0;
                animation: float 10s infinite ease-in-out alternate;
            }

            .orb-1 {
                width: 400px;
                height: 400px;
                background: var(--primary-glow);
                top: -5%;
                right: -5%;
            }

            .orb-2 {
                width: 350px;
                height: 350px;
                background: #1e3a8a;
                bottom: -5%;
                left: -5%;
                animation-delay: -5s;
            }

            @@keyframes float {
                0% {
                    transform: translate(0, 0);
                }

                100% {
                    transform: translate(-30px, 50px);
                }
            }

            .auth-container {
                width: 100%;
                max-width: 440px; /* Thu nhỏ bề ngang một chút cho cân đối */
                z-index: 1;
            }

            .auth-card {
                background: var(--card-bg);
                backdrop-filter: blur(24px);
                -webkit-backdrop-filter: blur(24px);
                border: 1px solid var(--border-color);
                border-radius: 20px;
                padding: 1.75rem 2rem; /* Giảm padding tổng thể */
                box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.1);
                animation: card-appear 0.6s cubic-bezier(0.16, 1, 0.3, 1);
                max-height: 95vh;
                overflow-y: auto;
            }

                .auth-card::-webkit-scrollbar {
                    width: 4px;
                }

                .auth-card::-webkit-scrollbar-track {
                    background: transparent;
                }

                .auth-card::-webkit-scrollbar-thumb {
                    background: rgba(255, 255, 255, 0.15);
                    border-radius: 10px;
                }

            @@keyframes card-appear {
                from {
                    opacity: 0;
                    transform: translateY(40px) scale(0.98);
                }

                to {
                    opacity: 1;
                    transform: translateY(0) scale(1);
                }
            }

            .auth-logo {
                width: 50px; /* Giảm size logo */
                height: 50px;
                background: linear-gradient(135deg, var(--primary-glow), var(--secondary-glow));
                border-radius: 14px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #fff;
                font-size: 1.25rem;
                margin: 0 auto 1rem;
                box-shadow: 0 10px 20px rgba(0, 212, 170, 0.3);
            }

            .auth-header {
                text-align: center;
                margin-bottom: 1.25rem; /* Giảm khoảng cách dưới header */
            }

            .auth-title {
                font-size: 1.35rem; /* Giảm size tiêu đề */
                font-weight: 700;
                color: var(--text-main);
                margin: 0 0 0.4rem 0;
                letter-spacing: -0.5px;
            }

            .auth-subtitle {
                font-size: 0.85rem;
                color: var(--text-muted);
                margin: 0;
                line-height: 1.4;
            }

            .input-group-custom {
                position: relative;
                margin-bottom: 0.9rem; /* Ép các ô input gần nhau hơn */
            }

            .form-label {
                display: block;
                font-size: 0.8rem;
                font-weight: 500;
                color: var(--text-muted);
                margin-bottom: 0.35rem;
            }

            .form-input-custom {
                width: 100%;
                background: var(--input-bg);
                border: 1px solid var(--border-color);
                border-radius: 10px;
                padding: 0.7rem 1rem 0.7rem 2.5rem; /* Thu nhỏ chiều cao ô input */
                color: var(--text-main);
                font-size: 0.9rem;
                outline: none;
                transition: var(--transition-smooth);
            }

                .form-input-custom::placeholder {
                    color: rgba(148, 163, 184, 0.5);
                }

                .form-input-custom:focus {
                    background: rgba(255, 255, 255, 0.06);
                    border-color: var(--primary-glow);
                    box-shadow: 0 0 0 3px rgba(0, 212, 170, 0.1);
                }

            .input-icon-custom {
                position: absolute;
                left: 0.9rem;
                bottom: 0.75rem;
                color: var(--text-muted);
                font-size: 0.9rem;
                pointer-events: none;
                transition: var(--transition-smooth);
            }

            .form-input-custom:focus + .input-icon-custom {
                color: var(--primary-glow);
            }

            .form-group {
                margin-bottom: 0.9rem;
            }

            .role-selector {
                display: flex;
                gap: 0.75rem;
                margin-top: 0.35rem;
            }

            .role-option {
                flex: 1;
                position: relative;
                cursor: pointer;
            }

                .role-option input {
                    position: absolute;
                    opacity: 0;
                    width: 0;
                    height: 0;
                }

            .role-card {
                border: 1px solid var(--border-color);
                border-radius: 10px;
                padding: 0.75rem 0.5rem; /* Thu nhỏ card chọn role */
                text-align: center;
                background: var(--input-bg);
                transition: var(--transition-smooth);
            }

                .role-card i {
                    font-size: 1.2rem;
                    margin-bottom: 0.3rem;
                    display: block;
                    color: var(--text-muted);
                    transition: var(--transition-smooth);
                }

                .role-card span {
                    font-size: 0.8rem;
                    font-weight: 600;
                    color: var(--text-muted);
                    transition: var(--transition-smooth);
                }

            .role-option:hover .role-card {
                background: rgba(255, 255, 255, 0.06);
            }

            .role-option input:checked + .role-card {
                border-color: var(--primary-glow);
                background: rgba(0, 212, 170, 0.1);
                box-shadow: 0 0 12px rgba(0, 212, 170, 0.15);
            }

                .role-option input:checked + .role-card i,
                .role-option input:checked + .role-card span {
                    color: var(--primary-glow);
                }

            .auth-btn {
                width: 100%;
                margin-top: 1.25rem;
                padding: 0.75rem;
                font-size: 0.95rem;
                font-weight: 600;
                color: #fff;
                background: linear-gradient(135deg, var(--primary-glow), var(--secondary-glow));
                border: none;
                border-radius: 10px;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 0.5rem;
                transition: var(--transition-smooth);
                box-shadow: 0 4px 15px rgba(0, 212, 170, 0.3);
            }

                .auth-btn:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 8px 20px rgba(0, 212, 170, 0.4);
                }

                .auth-btn:active {
                    transform: translateY(0);
                }

            .auth-link {
                text-align: center;
                margin-top: 1.25rem;
                font-size: 0.85rem;
                color: var(--text-muted);
            }

                .auth-link a {
                    color: var(--primary-glow);
                    text-decoration: none;
                    font-weight: 600;
                    margin-left: 0.25rem;
                    transition: var(--transition-smooth);
                }

                    .auth-link a:hover {
                        color: #fff;
                        text-shadow: 0 0 10px rgba(0, 212, 170, 0.5);
                    }

            .alert-error {
                background: rgba(244, 63, 94, 0.1);
                border: 1px solid rgba(244, 63, 94, 0.2);
                color: #fb7185;
                padding: 0.75rem 1rem;
                border-radius: 10px;
                font-size: 0.8rem;
                margin-bottom: 1.25rem;
                display: flex;
                align-items: center;
                gap: 0.75rem;
                font-weight: 500;
            }
    </style>
</head>
<body class="auth-body">
    <div class="bg-orb orb-1"></div>
    <div class="bg-orb orb-2"></div>

    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-logo">
                <i class="fa-solid fa-user-plus"></i>
            </div>

            <div class="auth-header">
                <h1 class="auth-title">Đăng Ký Tài Khoản</h1>
                <p class="auth-subtitle">Trải nghiệm hệ thống trợ lý học tập RAG AI thông minh</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert-error">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <span>@string.Join(" ", ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage))</span>
                </div>
            }

            <form method="post">
                <input type="hidden" asp-for="Input.ReturnUrl" />

                <div class="input-group-custom">
                    <label class="form-label" for="fullName">Họ và Tên</label>
                    <input id="fullName" type="text" asp-for="Input.FullName" class="form-input-custom" placeholder="Nguyễn Văn A" required />
                    <i class="fa-solid fa-user input-icon-custom"></i>
                </div>

                <div class="input-group-custom">
                    <label class="form-label" for="email">Địa chỉ Email</label>
                    <input id="email" type="email" asp-for="Input.Email" class="form-input-custom" placeholder="name@domain.com" required autocomplete="email" />
                    <i class="fa-solid fa-envelope input-icon-custom"></i>
                </div>

                <input type="hidden" asp-for="Input.Role" value="student" />

                <div class="input-group-custom">
                    <label class="form-label" for="password">Mật khẩu</label>
                    <input id="password" type="password" asp-for="Input.Password" class="form-input-custom" placeholder="Tối thiểu 6 ký tự" required />
                    <i class="fa-solid fa-lock input-icon-custom"></i>
                </div>

                <div class="input-group-custom" style="margin-bottom: 1.25rem;">
                    <label class="form-label" for="confirmPassword">Xác nhận mật khẩu</label>
                    <input id="confirmPassword" type="password" asp-for="Input.ConfirmPassword" class="form-input-custom" placeholder="Nhập lại mật khẩu" required />
                    <i class="fa-solid fa-shield-halved input-icon-custom"></i>
                </div>

                <button type="submit" class="auth-btn">
                    <i class="fa-solid fa-user-plus"></i> Đăng ký ngay
                </button>
            </form>

            <div class="auth-link">
                Đã có tài khoản? <a href="/Auth/Login?returnUrl=@Model.Input.ReturnUrl">Đăng nhập</a>
            </div>
        </div>
    </div>
</body>
</html>